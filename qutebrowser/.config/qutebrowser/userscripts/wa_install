#!/usr/bin/env bash
set -euo pipefail

url="$QUTE_URL"
title="$QUTE_TITLE"
host=$(python3 -c "from urllib.parse import urlparse; print(urlparse('$url').hostname)")

base="$HOME/.local/share/qute-pwa/$host"
mkdir -p "$base/config"

cat > "$base/config/config.py" <<EOF
config.load_autoconfig(False)
c.tabs.show = "never"
c.statusbar.show = "never"
c.window.title_format = "$title"
c.url.start_pages = ["$url"]
c.url.default_page = "$url"
c.auto_save.session = True
EOF

# --- Fetch a favicon ---
icon_dir="$HOME/.local/share/icons/qute-pwa"
mkdir -p "$icon_dir"
icon_path="$icon_dir/$host.png"

if [ ! -f "$icon_path" ]; then
    # Try common favicon locations, fall back to Google's favicon service
    scheme=$(python3 -c "from urllib.parse import urlparse; print(urlparse('$url').scheme)")
    candidates=(
        "$scheme://$host/favicon.ico"
        "https://www.google.com/s2/favicons?sz=128&domain=$host"
    )
    for c in "${candidates[@]}"; do
        if curl -sL --max-time 5 -o "$icon_path.tmp" "$c" && [ -s "$icon_path.tmp" ]; then
            # Convert to png if imagemagick is available; otherwise just use raw bytes
            if command -v convert >/dev/null 2>&1; then
                convert "$icon_path.tmp" "$icon_path" 2>/dev/null && rm -f "$icon_path.tmp" && break
            else
                mv "$icon_path.tmp" "$icon_path"
                break
            fi
        fi
    done
    rm -f "$icon_path.tmp" 2>/dev/null || true
fi

[ -f "$icon_path" ] || icon_path="qutebrowser"

desktop_dir="$HOME/.local/share/applications"
mkdir -p "$desktop_dir"
cat > "$desktop_dir/qute-pwa-$host.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$title
Comment=$url (qutebrowser app)
Exec=qutebrowser --basedir "$base" "$url"
Icon=$icon_path
Terminal=false
Categories=Network;
StartupWMClass=$host
EOF

update-desktop-database "$desktop_dir" 2>/dev/null || true

nohup qutebrowser --basedir "$base" "$url" >/dev/null 2>&1 &
disown

echo "message-info 'pwa_install: installed $host'" >> "$QUTE_FIFO"
echo "tab-close" >> "$QUTE_FIFO"
