# SECURE COPY #

# Copy the selection to a remote host over scp
cmd scp ${{
  read -rp "Port (default 22): " port
  port="${port:-22}"
  read -rp "Host (user@host:/path): " host
  [ -z "$host" ] && exit
  if [ -n "$fx" ]; then
    printf '%s\n' "$fx" | xargs -d '\n' -I{} scp -P "$port" "{}" "$host"
  else
    scp -P "$port" "$f" "$host"
  fi
}}
map cs scp

# UNDO #

# Undo the last paste, rename, chmod or trash action
cmd undo ${{
  sep=$(printf '\037')
  [ ! -f /tmp/lf_undo_$USER ] && echo "Nothing to undo." && exit
  last=$(tail -1 /tmp/lf_undo_$USER)
  action=$(printf '%s' "$last" | cut -d"$sep" -f1)
  data=$(printf '%s' "$last" | cut -d"$sep" -f2-)

  case "$action" in
    paste)
      rm -rf "$data"
      sed -i '$d' /tmp/lf_undo_$USER
      lf -remote 'send reload'
      ;;
    rename)
      old=$(printf '%s' "$data" | cut -d"$sep" -f1)
      new=$(printf '%s' "$data" | cut -d"$sep" -f2)
      mv -- "$new" "$old"
      sed -i '$d' /tmp/lf_undo_$USER
      lf -remote 'send reload'
      ;;
    chmod)
      perms=$(printf '%s' "$data" | cut -d"$sep" -f1)
      fp=$(printf '%s' "$data" | cut -d"$sep" -f2)
      chmod "$perms" "$fp"
      sed -i '$d' /tmp/lf_undo_$USER
      lf -remote 'send reload'
      ;;
    trash)
      path="$data"
      filename=$(basename "$path")
      trashinfo=~/.local/share/Trash/info/${filename}.trashinfo
      trashed=~/.local/share/Trash/files/${filename}
      if [ -e "$trashed" ] && [ -f "$trashinfo" ]; then
        mv "$trashed" "$path"
        rm "$trashinfo"
        sed -i '$d' /tmp/lf_undo_$USER
      else
        echo "Can't find $filename in trash"
      fi
      lf -remote 'send reload'
      ;;
  esac
}}
map u undo

