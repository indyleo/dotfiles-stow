# GIT #

# Switch git branches with fzf
cmd git_branch ${{
    branch=$(git branch | fzf | xargs)
    [ -z "$branch" ] && exit
    git checkout "$branch"
    pwd_shell="$(pwd | sed 's/\\/\\\\/g;s/"/\\"/g')"
    lf -remote "send $id updir; cd \"$pwd_shell\""
}}
map gB git_branch

# YANK #

# Copy the absolute path of the current file to the clipboard
cmd yank_path %{{
    # Works on both Wayland and X11
    if command -v wl-copy >/dev/null 2>&1; then
        printf '%s' "$f" | wl-copy
    elif command -v xclip >/dev/null 2>&1; then
        printf '%s' "$f" | xclip -selection clipboard
    fi
    echo "Copied path: $f"
}}
map yp yank_path

# BULK RENAME #

# Rename many files at once by editing their names in $EDITOR
cmd bulk_rename ${{
    set -eu

    olds=$(mktemp)
    names=$(mktemp)
    edited=$(mktemp)
    tg=$(mktemp)
    chg=$(mktemp)
    stage=$(mktemp -d "$PWD/.bulk_rename.XXXXXX")

    cleanup() {
        rm -f "$olds" "$names" "$edited" "$tg" "$chg"
        rmdir "$stage" 2>/dev/null || true
    }
    trap cleanup EXIT
    trap 'exit 1' HUP INT TERM

    # Full paths of the files to rename
    if [ -n "${fs:-}" ]; then
        printf '%s\n' "$fs"
    else
        find "$PWD" -mindepth 1 -maxdepth 1 ! -name '.*' | sort
    fi > "$olds"

    [ -s "$olds" ] || { echo "Nothing to rename." >&2; exit 1; }

    # The editor shows basenames only
    sed 's|.*/||' "$olds" > "$names"
    cp "$names" "$edited"
    "${EDITOR:-nvim}" "$edited"

    # Abort if the number of lines changed
    [ "$(wc -l < "$names")" -eq "$(wc -l < "$edited")" ] || {
        echo "Rename aborted: line count changed." >&2
        exit 1
    }

    # Validate names and build full target paths
    while IFS= read -r old <&3 && IFS= read -r new <&4; do
        case "$new" in
            ""|.|..|*/*)
                echo "Invalid filename: $new" >&2
                exit 1
                ;;
        esac
        printf '%s/%s\n' "${old%/*}" "$new"
    done 3< "$olds" 4< "$edited" > "$tg"

    # Check for duplicate targets
    dup=$(sort "$tg" | uniq -d | head -n 1)
    [ -z "$dup" ] || {
        echo "Duplicate target: ${dup##*/}" >&2
        exit 1
    }

    # Find which files are actually changing
    while IFS= read -r old <&3 && IFS= read -r new <&4; do
        [ "${old##*/}" = "$new" ] || printf '%s\n' "$old"
    done 3< "$olds" 4< "$edited" > "$chg"

    [ -s "$chg" ] || { echo "No changes."; exit 0; }

    # Reject targets that exist and aren't being moved out of the way
    while IFS= read -r old <&3 && IFS= read -r new <&4; do
        [ "${old##*/}" = "$new" ] && continue
        t="${old%/*}/$new"
        if [ -e "$t" ] || [ -L "$t" ]; then
            grep -qxF -- "$t" "$chg" || {
                echo "Target exists: $t" >&2
                exit 1
            }
        fi
    done 3< "$olds" 4< "$edited"

    # Phase 1: stage changed originals (allows swaps and cycles)
    i=0
    while IFS= read -r old <&3 && IFS= read -r new <&4; do
        i=$((i + 1))
        [ "${old##*/}" = "$new" ] || mv -- "$old" "$stage/$i"
    done 3< "$olds" 4< "$edited"

    # Phase 2: move into final names
    i=0
    while IFS= read -r old <&3 && IFS= read -r new <&4; do
        i=$((i + 1))
        [ "${old##*/}" = "$new" ] && continue
        mv -- "$stage/$i" "${old%/*}/$new" || {
            echo "Move failed; remaining files are in $stage" >&2
            exit 1
        }
    done 3< "$olds" 4< "$edited"

    lf -remote "send $id unselect"
    lf -remote "send $id reload"
}}
map R bulk_rename

# DISK USAGE #

# Show directory sizes sorted largest first
cmd du_sort ${{
    clear
    echo "Calculating disk usage for: $PWD"
    echo "----------------------------------------"
    du -h --max-depth=1 2>/dev/null | sort -hr
    echo "----------------------------------------"
    printf "Press Enter to return..."
    read -r
}}
map si du_sort

