# RENAME #

# Rename the current file by prompt and log for undo

cmd rename %{{
    sep=$(printf '\037')
    old="$f"
    oldname=$(basename -- "$old")
    dir=$(dirname -- "$old")

    printf " New name or substitution (s/pattern/replacement/): "
    IFS= read -r input
    [ -n "$input" ] || exit 0

    case "$input" in
        s/*)
            if ! newname=$(printf '%s\n' "$oldname" | sed -e "$input"); then
                echo "Invalid substitution."
                exit 1
            fi
            ;;
        *)
            newname="$input"
            ;;
    esac

    case "$newname" in
        ""|.|..|*/*)
            echo "Invalid filename: $newname" >&2
            exit 1
            ;;
    esac

    [ "$newname" != "$oldname" ] || exit 0
    newpath="$dir/$newname"

    if [ -e "$newpath" ] || [ -L "$newpath" ]; then
        echo "Target exists: $newpath" >&2
        exit 1
    fi

    mv -- "$old" "$newpath" || exit 1

    printf 'rename%s%s%s%s\n' \
        "$sep" "$old" "$sep" "$newpath" >> "/tmp/lf_undo_$USER"

    lf -remote 'send reload'
}}
map r rename

# OPEN FILE #

# Open a file with a handler based on mime type or extension
cmd open ${{
  mime=$(file --mime-type -Lb "$f")
  ext="${f##*.}"

  case "$mime" in
    text/*|application/json|application/xml)
      ${EDITOR:-nvim} "$f" ;;
    image/*)
      sxiv "$f" 2>/dev/null || imv "$f" 2>/dev/null || chafa "$f" ;;
    video/*|audio/*)
      mpv "$f" ;;
    application/pdf)
      zathura "$f" 2>/dev/null || pdftotext "$f" - | less ;;
    *)
      # Fall back to the file extension
      case "$ext" in
        sh|py|c|cpp|lua|rs|go|js|ts|md|json|yml|yaml)
          ${EDITOR:-nvim} "$f" ;;
        jpg|jpeg|png|gif|bmp|webp|svg)
          sxiv "$f" 2>/dev/null || imv "$f" ;;
        mp4|mkv|mp3|flac|ogg|wav)
          mpv "$f" ;;
        pdf)
          zathura "$f" 2>/dev/null || pdftotext "$f" - | less ;;
        *) xdg-open "$f" >/dev/null 2>&1 ;;
      esac
      ;;
  esac
}}

