# FOLLOW SYMLINK #

# Jump to a symlink's target, or edit it if it is a file
cmd follow-link %{{
    if [ ! -L "$f" ]; then
        echo "Not a symlink."
        exit 0
    fi
    target=$(readlink -f "$f")
    if [ -d "$target" ]; then
        dir=$target
    else
        dir=$(dirname -- "$target")
    fi
    esc_dir=$(printf '%s' "$dir" | sed 's/\\/\\\\/g; s/"/\\"/g')
    lf -remote "send $id cd \"$esc_dir\""
    if [ ! -d "$target" ]; then
        esc_target=$(printf '%s' "$target" | sed 's/\\/\\\\/g; s/"/\\"/g')
        lf -remote "send $id select \"$esc_target\""
    fi
}}
