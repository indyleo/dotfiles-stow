# YANK #

# Copy the absolute path of the current file to the clipboard
cmd yank %{{
    command -v wl-copy >/dev/null 2>&1 || command -v xclip >/dev/null 2>&1 || {
        echo "No clipboard tool (wl-copy/xclip) found."
        exit 1
    }
    clip() {
        if command -v wl-copy >/dev/null 2>&1; then
            wl-copy >/dev/null 2>&1
        else
            xclip -selection clipboard >/dev/null 2>&1
        fi
    }
    what="${1:-path}"
    case "$what" in
        path) printf '%s' "$fx" | clip ;;
        name) printf '%s' "$fx" | sed 's|.*/||' | clip ;;
        dir)  printf '%s' "$PWD" | clip ;;
        content)
            [ -f "$f" ] || { echo "Not a file."; exit 1; }
            case "$(file --mime-type -Lb -- "$f")" in
                text/*|application/json|application/xml) ;;
                *) echo "Not a text file."; exit 1 ;;
            esac
            [ "$(stat -c %s -- "$f")" -le 1048576 ] || { echo "File is over 1 MiB."; exit 1; }
            clip < "$f"
            ;;
        image)
            [ -f "$f" ] || { echo "Not a file."; exit 1; }
            mime=$(file --mime-type -Lb -- "$f")
            case "$mime" in image/*) ;; *) echo "Not an image."; exit 1 ;; esac
            # Most apps only accept png from the clipboard, so convert anything else
            png=$(mktemp --suffix=.png)
            trap 'rm -f "$png"' EXIT
            if [ "$mime" = image/png ]; then
                cp -- "$f" "$png"
            else
                command -v magick >/dev/null 2>&1 || { echo "magick not found, install imagemagick"; exit 1; }
                magick "${f}[0]" -auto-orient "$png" 2>/dev/null || { echo "Conversion failed."; exit 1; }
            fi
            if command -v wl-copy >/dev/null 2>&1; then
                wl-copy --type image/png < "$png" >/dev/null 2>&1
            else
                xclip -selection clipboard -t image/png -i "$png" >/dev/null 2>&1
            fi
            ;;
        *) echo "usage: yank path|name|dir|content|image"; exit 1 ;;
    esac
    echo "Copied $what to clipboard"
}}
map yp yank path
map yn yank name
map yd yank dir
map yc yank content
map yi yank image

# BULK RENAME #

# Rename many files at once by editing their names in $EDITOR
cmd bulk_rename ${{
    set -eu

    olds=$(mktemp)
    names=$(mktemp)
    edited=$(mktemp)
    tg=$(mktemp)
    chg=$(mktemp)
		sep=$(printf '\037')
    stage=$(mktemp -d "$PWD/.bulk_rename.XXXXXX")

    cleanup() {
        rm -f "$olds" "$names" "$edited" "$tg" "$chg"
        rmdir "$stage" 2>/dev/null || true
    }
    trap cleanup EXIT
    trap 'exit 1' HUP INT TERM

    # Full paths of the files to rename
    if [ -n "${fs:-}" ]; then
        printf '%s\n' "$fs"
    else
        find "$PWD" -mindepth 1 -maxdepth 1 ! -name '.*' | sort
    fi > "$olds"

    [ -s "$olds" ] || { echo "Nothing to rename." >&2; exit 1; }

    # The editor shows basenames only
    sed 's|.*/||' "$olds" > "$names"
    cp "$names" "$edited"
    "${EDITOR:-nvim}" "$edited"

    # Abort if the number of lines changed
    [ "$(wc -l < "$names")" -eq "$(wc -l < "$edited")" ] || {
        echo "Rename aborted: line count changed." >&2
        exit 1
    }

    # Validate names and build full target paths
    while IFS= read -r old <&3 && IFS= read -r new <&4; do
        case "$new" in
            ""|.|..|*/*)
                echo "Invalid filename: $new" >&2
                exit 1
                ;;
        esac
        printf '%s/%s\n' "${old%/*}" "$new"
    done 3< "$olds" 4< "$edited" > "$tg"

    # Check for duplicate targets
    dup=$(sort "$tg" | uniq -d | head -n 1)
    [ -z "$dup" ] || {
        echo "Duplicate target: ${dup##*/}" >&2
        exit 1
    }

    # Find which files are actually changing
    while IFS= read -r old <&3 && IFS= read -r new <&4; do
        [ "${old##*/}" = "$new" ] || printf '%s\n' "$old"
    done 3< "$olds" 4< "$edited" > "$chg"

    [ -s "$chg" ] || { echo "No changes."; exit 0; }

    # Reject targets that exist and aren't being moved out of the way
    while IFS= read -r old <&3 && IFS= read -r new <&4; do
        [ "${old##*/}" = "$new" ] && continue
        t="${old%/*}/$new"
        if [ -e "$t" ] || [ -L "$t" ]; then
            grep -qxF -- "$t" "$chg" || {
                echo "Target exists: $t" >&2
                exit 1
            }
        fi
    done 3< "$olds" 4< "$edited"

    # Phase 1: stage changed originals (allows swaps and cycles)
    i=0
    while IFS= read -r old <&3 && IFS= read -r new <&4; do
        i=$((i + 1))
        [ "${old##*/}" = "$new" ] || mv -- "$old" "$stage/$i"
    done 3< "$olds" 4< "$edited"

    # Phase 2: move into final names
    i=0
    while IFS= read -r old <&3 && IFS= read -r new <&4; do
        i=$((i + 1))
        [ "${old##*/}" = "$new" ] && continue
        mv -- "$stage/$i" "${old%/*}/$new" || {
            echo "Move failed; remaining files are in $stage" >&2
            exit 1
        }
    done 3< "$olds" 4< "$edited"

    # Record all changed paths in a single undo-log entry.
    # Format: bulk_rename<sep>old1<sep>new1<sep>old2<sep>new2...
    log="/tmp/lf_undo_$USER"
    printf 'bulk_rename%s' "$sep" >> "$log"

    while IFS= read -r old <&3 && IFS= read -r new <&4; do
        [ "${old##*/}" = "$new" ] && continue
        printf '%s%s%s%s' \
            "$old" "$sep" "${old%/*}/$new" "$sep" >> "$log"
    done 3< "$olds" 4< "$edited"

    printf '\n' >> "$log"

    lf -remote "send $id unselect"
    lf -remote "send $id reload"
}}
map R bulk_rename

# SELECT BY PATTERN #

# Select / unselect files matching a glob (v already inverts the selection)
cmd select_glob %{{
    printf " Glob to select: "
    read -r g
    [ -n "$g" ] || exit 0
    g=$(printf '%s' "$g" | sed 's/\\/\\\\/g; s/"/\\"/g')
    lf -remote "send $id glob-select \"$g\""
}}

cmd unselect_glob %{{
    printf " Glob to unselect: "
    read -r g
    [ -n "$g" ] || exit 0
    g=$(printf '%s' "$g" | sed 's/\\/\\\\/g; s/"/\\"/g')
    lf -remote "send $id glob-unselect \"$g\""
}}

# Select every file with the same extension as the current one
cmd select_ext %{{
    name=${f##*/}
    case "$name" in
        .*.*|[!.]*.*) ;;
        *) echo "No extension on $name"; exit 0 ;;
    esac
    lf -remote "send $id glob-select \"*.${name##*.}\""
}}
map sg select_glob
map sG unselect_glob
map sx select_ext

# DUPLICATE / SYMLINK #

# Copy each selected item next to itself as name_copy.ext (logged for undo)
cmd duplicate %{{
    sep=$(printf '\037')
    for src in $fx; do
        dir=$(dirname -- "$src")
        base=$(basename -- "$src")
        stem=$base
        ext=
        if [ ! -d "$src" ]; then
            case "$base" in
                .*.*|[!.]*.*) stem=${base%.*}; ext=.${base##*.} ;;
            esac
        fi
        target="$dir/${stem}_copy$ext"
        n=1
        while [ -e "$target" ]; do
            target="$dir/${stem}_copy$n$ext"
            n=$((n + 1))
        done
        cp -r -- "$src" "$target"
        printf 'duplicate%s%s\n' "$sep" "$target" >> /tmp/lf_undo_$USER
    done
    lf -remote "send $id reload"
}}
map dc duplicate

# Symlink the copied/cut files into this directory (":symlink rel" = relative links)
cmd symlink %{{
    sep=$(printf '\037')
    flags=-s
    [ "${1:-}" = rel ] && flags=-sr
    sel_file="${XDG_DATA_HOME:-$HOME/.local/share}/lf/files"
    [ -f "$sel_file" ] || { echo "Nothing copied or cut."; exit 1; }
    list=$(sed '1d' "$sel_file")
    [ -n "$list" ] || { echo "Nothing copied or cut."; exit 1; }
    printf '%s\n' "$list" | while IFS= read -r src; do
        [ -n "$src" ] || continue
        base=$(basename -- "$src")
        target="$PWD/$base"
        n=1
        while [ -e "$target" ] || [ -L "$target" ]; do
            target="$PWD/${base}_$n"
            n=$((n + 1))
        done
        ln $flags -- "$src" "$target"
        printf 'link%s%s\n' "$sep" "$target" >> /tmp/lf_undo_$USER
    done
    lf -remote "send $id reload"
}}
map sl symlink
map sL symlink rel

# FZF CD / RECENT #

# Fuzzy jump to any directory below here
cmd fzf_cd ${{
    res=$(fd --type d --hidden --exclude .git . 2>/dev/null |
        fzf --reverse --prompt='cd > ' \
            --preview 'eza -a --tree --level=1 --group-directories-first --color=always --icons {} 2>/dev/null')
    [ -n "$res" ] || exit 0
    esc=$(printf '%s' "$res" | sed 's/\\/\\\\/g; s/"/\\"/g')
    lf -remote "send $id cd \"$esc\""
}}

# Fuzzy jump to a file changed in the last 7 days and select it
cmd fzf_recent ${{
    res=$(fd --type f --hidden --exclude .git --changed-within 7d . 2>/dev/null |
        fzf --reverse --prompt='Recent > ' \
            --preview 'bat --color=always --style=numbers --line-range=:100 {} 2>/dev/null || cat {}')
    [ -n "$res" ] || exit 0
    abs="$PWD/$res"
    esc_dir=$(dirname -- "$abs" | sed 's/\\/\\\\/g; s/"/\\"/g')
    esc_abs=$(printf '%s' "$abs" | sed 's/\\/\\\\/g; s/"/\\"/g')
    lf -remote "send $id cd \"$esc_dir\""
    lf -remote "send $id select \"$esc_abs\""
}}
map fc fzf_cd
map fr fzf_recent

# MOUNT / UNMOUNT #

# Pick an unmounted partition, mount it with udisksctl and jump to it
cmd mount_dev ${{
    dev=$(lsblk -prnl -o NAME,FSTYPE,MOUNTPOINT,SIZE,LABEL |
        awk -F'[ ]' '$2 != "" && $3 == "" && $2 !~ /^(swap|LVM2_member|crypto_LUKS)$/ {printf "%s\t%s\t%s\t%s\n", $1, $4, $2, $5}' |
        fzf --reverse --prompt='Mount > ' | cut -f1)
    [ -n "$dev" ] || exit 0
    if ! out=$(udisksctl mount -b "$dev" 2>&1); then
        printf '%s\n' "$out"
        printf "Press Enter to continue..."
        read -r _
        exit 1
    fi
    mnt=${out##* at }
    mnt=${mnt%.}
    esc=$(printf '%s' "$mnt" | sed 's/\\/\\\\/g; s/"/\\"/g')
    lf -remote "send $id cd \"$esc\""
}}

# Pick a device mounted under /run/media and unmount it
cmd umount_dev ${{
    dev=$(lsblk -prnl -o NAME,FSTYPE,MOUNTPOINT,SIZE,LABEL |
        awk -F'[ ]' '$3 ~ /^\/run\/media\// {printf "%s\t%s\t%s\n", $1, $4, $3}' |
        fzf --reverse --prompt='Unmount > ' | cut -f1)
    [ -n "$dev" ] || exit 0
    mnt=$(findmnt -no TARGET "$dev" | head -n 1)
    case "$PWD/" in
        "$mnt"/*) lf -remote "send $id cd ~"; sleep 0.3 ;;
    esac
    if out=$(udisksctl unmount -b "$dev" 2>&1); then
        lf -remote "send $id echo \"Unmounted $dev\""
    else
        printf '%s\n' "$out"
        printf "Press Enter to continue..."
        read -r _
        exit 1
    fi
}}
map bm mount_dev
map bu umount_dev

# TERMINAL / INFO / CHECKSUM #

# Open a terminal in the current directory
cmd term &{{
    setsid -f ${TERMINAL:-st} >/dev/null 2>&1
}}
map gt term

# File details in the pager
cmd fileinfo ${{
    {
        stat -- "$f"
        echo
        file --brief -- "$f"
        echo
        if command -v exiftool >/dev/null 2>&1; then
            exiftool -- "$f" 2>/dev/null
        elif command -v mediainfo >/dev/null 2>&1; then
            mediainfo "$f" 2>/dev/null
        fi
    } | less -R
}}
map sf fileinfo

# sha256 of the selection to the clipboard (just the hash for a single file)
cmd checksum %{{
    command -v wl-copy >/dev/null 2>&1 || command -v xclip >/dev/null 2>&1 || {
        echo "No clipboard tool (wl-copy/xclip) found."
        exit 1
    }
    out=$(sha256sum -- $fx 2>&1) || { printf '%s\n' "$out" | head -n 1; exit 1; }
    if [ "$(printf '%s\n' "$fx" | wc -l)" -eq 1 ]; then
        text=${out%% *}
    else
        text=$out
    fi
    if command -v wl-copy >/dev/null 2>&1; then
        printf '%s' "$text" | wl-copy >/dev/null 2>&1
    else
        printf '%s' "$text" | xclip -selection clipboard >/dev/null 2>&1
    fi
    echo "sha256 copied: ${out%% *}"
}}
map sh checksum

# DISK USAGE #

# Show directory sizes sorted largest first
cmd du_sort ${{
    clear
    echo "Calculating disk usage for: $PWD"
    du -h --max-depth=1 2>/dev/null | sort -hr | ${PAGER:-less}
}}
map si du_sort

