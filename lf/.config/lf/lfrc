# Go to the removable media directory
cmd media ${{
  lf -remote "send $id cd '/run/media/$USER/'"
}}
map gM media

# FILE CREATION #

# Create a directory, file, script or project by prompt
cmd mk ${{
  printf "Name: "
  read -r name
  [ -z "$name" ] && exit

  printf "Type (dir/file/script/proj): "
  read -r type
  case "$type" in
    dir|d) mkdir -pv -- "$name" ;;
    file|f) :> "$name" ;;
    script|scr|s) mkscript -n "$name" && lf -remote "send $id cd '~/Scripts/'" ;;
    project|proj|p)
      projtool mkproj -n "$name" || exit
      esc_name=$(printf '%s' "$name" | sed 's/\\/\\\\/g; s/"/\\"/g')
      lf -remote "send $id cd \"$HOME/Projects/$esc_name\""
      ;;
    *) echo "Unknown type." ;;
  esac
  lf -remote 'send reload'
}}
map mm mk

# DELETE / TRASH #

# Move the selection to the trash and log it for undo
cmd trash %{{
    sep=$(printf '\037')
    for f in $fx; do
        printf 'trash%s%s\n' "$sep" "$f" >> /tmp/lf_undo_$USER
        trash-put -vr "$f"
    done
}}

# List trashed files in the pager
cmd trash-list ${{
    trash-list | ${PAGER:-less}
}}

# Restore files from the trash
cmd trash-restore ${{
    trash-restore
}}

# Empty the trash
cmd trash-empty %{{
    trash-empty
}}

# Permanently delete the selection
cmd remove %{{
    for f in $fx; do
        rm -rfv "$f"
    done
}}
map DD remove
map dd trash
map tt trash-list
map tr trash-restore
map te trash-empty

# PASTE (WITH UNDO SUPPORT) #

# Paste copied or cut files without overwriting and log for undo
cmd paste %{{
    sep=$(printf '\037')
    sel_file="${XDG_DATA_HOME:-$HOME/.local/share}/lf/files"
    [ -f "$sel_file" ] || exit
    load=$(cat "$sel_file")
    mode=$(printf '%s\n' "$load" | sed -n '1p')
    list=$(printf '%s\n' "$load" | sed '1d')
    [ -z "$list" ] && exit

    printf '%s\n' "$list" | while IFS= read -r src; do
        [ -z "$src" ] && continue
        base=$(basename -- "$src")
        target="$PWD/$base"
        n=1
        while [ -e "$target" ]; do
            target="$PWD/${base}_$n"
            n=$((n + 1))
        done
        if [ "$mode" = 'copy' ]; then
            cp -r -- "$src" "$target"
        else
            mv -- "$src" "$target"
        fi
        printf 'paste%s%s\n' "$sep" "$target" >> /tmp/lf_undo_$USER
    done
    lf -remote 'send clear'
    lf -remote 'send reload'
}}
map p paste

# TOGGLE EXECUTABLE / PERMISSIONS #

# Change file permissions by prompt and log for undo
cmd chmod %{{
  sep=$(printf '\037')
  oldperms=$(stat -c "%a" "$f")
  printf "Chmod bits: "
  read -r bits
  [ -z "$bits" ] && exit
  chmod "$bits" "$f"
  printf 'chmod%s%s%s%s\n' "$sep" "$oldperms" "$sep" "$f" >> /tmp/lf_undo_$USER
  lf -remote 'send reload'
}}
map et chmod

# ARCHIVE / EXTRACT #

# Extract the selected archives
cmd extract %{{
  for f in $fx; do
    archives extract "$f"
  done
  lf -remote 'send reload'
}}
map ex extract

# Archive the selection into a named archive
cmd archive %{{
  printf " Archive name (.tar.gz/.zip/.rar): "
  read -r out
  [ -z "$out" ] && exit
  archives archive "$out" $fx
  lf -remote 'send reload'
}}
map er archive

# FZF JUMP #

# Fuzzy find any file or directory and jump to it
cmd fzf_jump ${{
  res=$(fd --hidden --exclude .git . 2>/dev/null | \
    fzf --reverse \
        --preview '[ -d {} ] && eza -a --tree --level=2 --group-directories-first --color=always --icons {} 2>/dev/null || bat --color=always --style=numbers --line-range=:100 {} 2>/dev/null || cat {}' \
        </dev/tty)
  [ -z "$res" ] && exit
  esc_res=$(printf '%s' "$res" | sed 's/\\/\\\\/g; s/"/\\"/g')
  if [ -d "$res" ]; then
    lf -remote "send $id cd \"$esc_res\""
  else
    esc_dir=$(dirname "$res" | sed 's/\\/\\\\/g; s/"/\\"/g')
    lf -remote "send $id cd \"$esc_dir\""
    lf -remote "send $id select \"$esc_res\""
    lf -remote "send $id open"
  fi
}}
map fj fzf_jump

# FZF SEARCH #

# Search file contents with ripgrep and select the match
cmd fzf_search ${{
    cmd="rg --column --line-number --no-heading --color=always --smart-case"
    fzf --ansi --disabled --layout=reverse --header="Search in files" --delimiter=: \
        --bind="start:reload([ -n {q} ] && $cmd -- {q} || true)" \
        --bind="change:reload([ -n {q} ] && $cmd -- {q} || true)" \
        --bind='enter:become(lf -remote "send $id select \"$(printf "%s" {1} | sed '\''s/\\/\\\\/g;s/"/\\"/g'\'')\"")' \
        --preview-window='+{2}-/2' \
        --preview='bat --color=always --highlight-line={2} -- {1}'
}}
map fg fzf_search

# FOLLOW SYMLINK #

# Jump to a symlink's target, or edit it if it is a file
cmd follow-link ${{
  [ ! -L "$f" ] && echo "Not a symlink." && exit
  target=$(readlink -f "$f")
  esc_target=$(printf '%s' "$target" | sed 's/\\/\\\\/g; s/"/\\"/g')
  if [ -d "$target" ]; then
    lf -remote "send $id cd \"$esc_target\""
  elif [ -f "$target" ]; then
    esc_dir=$(dirname "$target" | sed 's/\\/\\\\/g; s/"/\\"/g')
    lf -remote "send $id cd \"$esc_dir\""
    ${EDITOR:-nvim} "$target"
  fi
}}
map gf follow-link

# RENAME #

# Rename the current file by prompt and log for undo
cmd rename %{{
  sep=$(printf '\037')
  old="$f"
  oldname=$(basename "$old")
  printf " New name: "
  read -r newname
  [ -z "$newname" ] && exit
  newpath="$(dirname "$old")/$newname"
  mv -- "$old" "$newpath"
  printf 'rename%s%s%s%s\n' "$sep" "$old" "$sep" "$newpath" >> /tmp/lf_undo_$USER
  lf -remote 'send reload'
}}
map r rename

# OPEN FILE #

# Open a file with a handler based on mime type or extension
cmd open ${{
  mime=$(file --mime-type -Lb "$f")
  ext="${f##*.}"

  case "$mime" in
    text/*|application/json|application/xml)
      ${EDITOR:-nvim} "$f" ;;
    image/*)
      sxiv "$f" 2>/dev/null || imv "$f" 2>/dev/null || chafa "$f" ;;
    video/*|audio/*)
      mpv "$f" ;;
    application/pdf)
      zathura "$f" 2>/dev/null || pdftotext "$f" - | less ;;
    *)
      # Fall back to the file extension
      case "$ext" in
        sh|py|c|cpp|lua|rs|go|js|ts|md|json|yml|yaml)
          ${EDITOR:-nvim} "$f" ;;
        jpg|jpeg|png|gif|bmp|webp|svg)
          sxiv "$f" 2>/dev/null || imv "$f" ;;
        mp4|mkv|mp3|flac|ogg|wav)
          mpv "$f" ;;
        pdf)
          zathura "$f" 2>/dev/null || pdftotext "$f" - | less ;;
        *) xdg-open "$f" >/dev/null 2>&1 ;;
      esac
      ;;
  esac
}}
map <enter> open

