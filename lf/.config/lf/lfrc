### FZF JUMP ###
cmd fzf_jump ${{
  res=$(fd --hidden --exclude .git . 2>/dev/null | \
    fzf --reverse \
        --preview '[ -d {} ] && eza -a --tree --level=2 --group-directories-first --color=always --icons {} 2>/dev/null || batcat --color=always --style=numbers --line-range=:100 {} 2>/dev/null || cat {}' \
        </dev/tty)
  [ -z "$res" ] && exit
  # NOTE: $res is a real filesystem path and could contain a single quote.
  # See the same note in `cmd mk` above - use double quotes + backslash
  # escaping so lf's remote parser handles it correctly either way.
  esc_res=$(printf '%s' "$res" | sed 's/\\/\\\\/g; s/"/\\"/g')
  if [ -d "$res" ]; then
    lf -remote "send $id cd \"$esc_res\""
  else
    esc_dir=$(dirname "$res" | sed 's/\\/\\\\/g; s/"/\\"/g')
    lf -remote "send $id cd \"$esc_dir\""
    lf -remote "send $id select \"$esc_res\""
    lf -remote "send $id open"
  fi
}}
map fj fzf_jump

### FOLLOW SYMLINK ###
cmd follow-link ${{
  [ ! -L "$f" ] && echo "Not a symlink." && exit
  target=$(readlink -f "$f")
  # See the quoting note in `cmd mk` above - $target could contain a
  # single quote.
  esc_target=$(printf '%s' "$target" | sed 's/\\/\\\\/g; s/"/\\"/g')
  if [ -d "$target" ]; then
    lf -remote "send $id cd \"$esc_target\""
  elif [ -f "$target" ]; then
    esc_dir=$(dirname "$target" | sed 's/\\/\\\\/g; s/"/\\"/g')
    lf -remote "send $id cd \"$esc_dir\""
    ${EDITOR:-nvim} "$target"
  fi
}}
map gf follow-link

### RENAME ###
cmd rename ${{
  sep=$(printf '\037')
  old="$f"
  oldname=$(basename "$old")
  printf "New name: "
  read -r newname
  [ -z "$newname" ] && exit
  newpath="$(dirname "$old")/$newname"
  mv -- "$old" "$newpath"
  printf 'rename%s%s%s%s\n' "$sep" "$old" "$sep" "$newpath" >> /tmp/lf_undo_$USER
  lf -remote 'send reload'
}}
map r rename

### OPEN FILE ###
cmd open ${{
  mime=$(file --mime-type -Lb "$f")
  ext="${f##*.}"

  case "$mime" in
    text/*|application/json|application/xml)
      ${EDITOR:-nvim} "$f" ;;
    image/*)
      sxiv "$f" 2>/dev/null || imv "$f" 2>/dev/null || chafa "$f" ;;
    video/*|audio/*)
      mpv "$f" ;;
    application/pdf)
      zathura "$f" 2>/dev/null || pdftotext "$f" - | less ;;
    *)
      # fallback based on extension
      case "$ext" in
        sh|py|c|cpp|lua|rs|go|js|ts|md|json|yml|yaml)
          ${EDITOR:-nvim} "$f" ;;
        jpg|jpeg|png|gif|bmp|webp|svg)
          sxiv "$f" 2>/dev/null || imv "$f" ;;
        mp4|mkv|mp3|flac|ogg|wav)
          mpv "$f" ;;
        pdf)
          zathura "$f" 2>/dev/null || pdftotext "$f" - | less ;;
        *) xdg-open "$f" >/dev/null 2>&1 ;;
      esac
      ;;
  esac
}}
map <enter> open

