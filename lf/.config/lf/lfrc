# UNDO #

# Undo the last paste, rename, chmod or trash action
cmd undo %{{
  sep=$(printf '\037')
  [ ! -f /tmp/lf_undo_$USER ] && echo "Nothing to undo." && exit
  last=$(tail -1 /tmp/lf_undo_$USER)
  action=$(printf '%s' "$last" | cut -d"$sep" -f1)
  data=$(printf '%s' "$last" | cut -d"$sep" -f2-)

  case "$action" in
    paste)
      rm -rf "$data"
      sed -i '$d' /tmp/lf_undo_$USER
      lf -remote 'send reload'
      ;;
    rename)
      old=$(printf '%s' "$data" | cut -d"$sep" -f1)
      new=$(printf '%s' "$data" | cut -d"$sep" -f2)
      mv -- "$new" "$old"
      sed -i '$d' /tmp/lf_undo_$USER
      lf -remote 'send reload'
      ;;

    bulk_rename)
      fields=$(mktemp)
      olds=$(mktemp)
      news=$(mktemp)

      printf '%s' "$data" | tr "$sep" '\n' > "$fields"

      # Parse the alternating original and new paths.
      exec 3< "$fields"
      while IFS= read -r old <&3; do
        IFS= read -r new <&3 || {
          echo "Invalid bulk rename log." >&2
          exec 3<&-
          rm -f "$fields" "$olds" "$news"
          exit 1
        }
        [ -n "$old" ] && [ -n "$new" ] || continue
        printf '%s\n' "$old" >> "$olds"
        printf '%s\n' "$new" >> "$news"
      done
      exec 3<&-

      [ -s "$olds" ] || {
        echo "Empty bulk rename log." >&2
        rm -f "$fields" "$olds" "$news"
        exit 1
      }

      # All renamed paths must still exist.
      while IFS= read -r new; do
        if [ ! -e "$new" ] && [ ! -L "$new" ]; then
          echo "Cannot undo: missing $new" >&2
          rm -f "$fields" "$olds" "$news"
          exit 1
        fi
      done < "$news"

      # Original destinations must be free or occupied by a
      # file that this same undo operation will move away.
      while IFS= read -r old; do
        if [ -e "$old" ] || [ -L "$old" ]; then
          if ! grep -qxF -- "$old" "$news"; then
            echo "Cannot undo: target exists: $old" >&2
            rm -f "$fields" "$olds" "$news"
            exit 1
          fi
        fi
      done < "$olds"

      first=$(head -n 1 "$news")
      parent=$(dirname -- "$first")
      stage=$(mktemp -d "$parent/.lf_undo.XXXXXX") || {
        rm -f "$fields" "$olds" "$news"
        exit 1
      }

      # Stage all renamed files before restoring original names.
      i=0
      while IFS= read -r new; do
        i=$((i + 1))
        if ! mv -- "$new" "$stage/$i"; then
          echo "Undo staging failed; recovery files: $stage" >&2
          rm -f "$fields" "$olds" "$news"
          exit 1
        fi
      done < "$news"

      i=0
      while IFS= read -r old; do
        i=$((i + 1))
        if ! mv -- "$stage/$i" "$old"; then
          echo "Undo restore failed; recovery files: $stage" >&2
          rm -f "$fields" "$olds" "$news"
          exit 1
        fi
      done < "$olds"

      rmdir "$stage"
      rm -f "$fields" "$olds" "$news"
      sed -i '$d' "/tmp/lf_undo_$USER"
      lf -remote 'send reload'
      ;;
    chmod)
      perms=$(printf '%s' "$data" | cut -d"$sep" -f1)
      fp=$(printf '%s' "$data" | cut -d"$sep" -f2)
      chmod "$perms" "$fp"
      sed -i '$d' /tmp/lf_undo_$USER
      lf -remote 'send reload'
      ;;
    trash)
      path="$data"
      filename=$(basename "$path")
      trashinfo=~/.local/share/Trash/info/${filename}.trashinfo
      trashed=~/.local/share/Trash/files/${filename}
      if [ -e "$trashed" ] && [ -f "$trashinfo" ]; then
        mv "$trashed" "$path"
        rm "$trashinfo"
        sed -i '$d' /tmp/lf_undo_$USER
      else
        echo "Can't find $filename in trash"
      fi
      lf -remote 'send reload'
      ;;
    mkdir)
      rmdir -- "$data" 2>/dev/null || echo "Not removed (missing or not empty): $data"
      sed -i '$d' /tmp/lf_undo_$USER
      lf -remote 'send reload'
      ;;
    mkfile)
      if [ -s "$data" ]; then
        echo "Not removed (file has content): $data"
      else
        rm -f -- "$data"
      fi
      sed -i '$d' /tmp/lf_undo_$USER
      lf -remote 'send reload'
      ;;
    mkscr|duplicate|convert)
      rm -rf -- "$data"
      sed -i '$d' /tmp/lf_undo_$USER
      lf -remote 'send reload'
      ;;
    link|archive)
      rm -f -- "$data"
      sed -i '$d' /tmp/lf_undo_$USER
      lf -remote 'send reload'
      ;;
    extract)
      printf '%s\n' "$data" | tr "$sep" '\n' | while IFS= read -r p; do
        [ -n "$p" ] || continue
        rm -rf -- "$p"
      done
      sed -i '$d' /tmp/lf_undo_$USER
      lf -remote 'send reload'
      ;;
  esac
}}
map u undo

