# SETTINGS #

set previewer ~/.config/lf/preview
set rulerfile ~/.config/lf/ruler
set preview true
set hidden true
set drawbox true
set icons true
set ignorecase true
set scrolloff 10
set shellopts '-eu'
set ifs "\n"
set sixel true
set info custom

# Shell command types:
#   %{{ }}  runs inside lf, no tty, output goes to the statusline
#   &{{ }}  async, for GUI apps and background jobs
#   ${{ }}  suspends lf, for TUIs, fzf and prompts
#   !{{ }}  like $ but waits for a keypress so you can read the output

# HOOKS #

# Show eza details for the selected file in the statusline
cmd on-select &{{
    lf -remote "send $id set user_statfmt \"$(eza -ld --color=always "$f" | sed 's/\\/\\\\/g;s/"/\\"/g')\""
}}

# Track the directory in zoxide and show git branch info
cmd on-cd &{{
    zoxide add "$PWD"

    branch_info=""
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        branch=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)
        if [ -n "$branch" ]; then
            mark=""
            [ -n "$(git status --porcelain 2>/dev/null)" ] && mark=" ·"
            counts=$(git rev-list --left-right --count '@{u}...HEAD' 2>/dev/null)
            behind=$(printf '%s' "$counts" | cut -f1)
            ahead=$(printf '%s' "$counts" | cut -f2)
            [ -n "$behind" ] && [ "$behind" != "0" ] && mark="$mark ↓$behind"
            [ -n "$ahead" ] && [ "$ahead" != "0" ] && mark="$mark ↑$ahead"
            branch_info=" $branch$mark"
        fi
    fi
    esc_branch=$(printf '%s' "$branch_info" | sed 's/\\/\\\\/g;s/"/\\"/g')
    lf -remote "send $id set user_gitbranch \"$esc_branch\""
}}

# Attach git status to loaded files as custom info
cmd on-load &{{
    cd "$(dirname "$1")" || exit 1
    [ "$(git rev-parse --is-inside-git-dir 2>/dev/null)" = false ] || exit 0
    cmds=""
    for file in "$@"; do
        case "$file" in */.git|*/.git/*) continue;; esac
				status=$(git status --porcelain -- "$file" | cut -c1-2 | head -n1)
        cmds="${cmds}addcustominfo ${file} \"$status\"; "
    done
    lf -remote "send $id :$cmds"
}}

