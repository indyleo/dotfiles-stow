### FILE CREATION ###
cmd mk ${{
  printf "Name: "
  read -r name
  [ -z "$name" ] && exit

  printf "Type (dir/file/script/proj): "
  read -r type
  case "$type" in
    dir) mkdir -pv -- "$name" ;;
    file) :> "$name" ;;
    script) mkscript -n "$name" && lf -remote "send $id cd '~/Scripts/'" ;;
    proj)
      projtool mkproj -n "$name" || exit
      # NOTE: $name is free-typed user input and may contain a single quote
      # (e.g. "John's App"), which would break out of the single-quoted
      # argument lf -remote sends below (lf's own doc.md: single-quoted
      # values have no escape mechanism, only double-quoted ones do).
      # Escape backslashes/quotes and use double quotes instead so lf's
      # own parser reconstructs the path correctly.
      esc_name=$(printf '%s' "$name" | sed 's/\\/\\\\/g; s/"/\\"/g')
      lf -remote "send $id cd \"$HOME/Projects/$esc_name\""
      ;;
    *) echo "Unknown type." ;;
  esac
  lf -remote 'send reload'
}}
map mm mk

### DELETE / TRASH ###
# NOTE: undo records below use \x1f (a control character that can't appear
# in a real filename) as the field separator instead of a literal "|".
# A literal "|" is a legal (if rare) character in a Unix filename, and using
# it as an unescaped delimiter would silently corrupt/truncate the record
# for any file that happens to contain one.
cmd trash %{{
    sep=$(printf '\037')
    for f in $fx; do
        printf 'trash%s%s\n' "$sep" "$f" >> /tmp/lf_undo_$USER
        trash-put -vr "$f"
    done
}}
cmd trash-list ${{
    trash-list | moar
}}
cmd trash-restore ${{
    trash-restore
}}
cmd trash-empty %{{
    trash-empty
}}
cmd remove %{{
    for f in $fx; do
        rm -rfv "$f"
    done
}}
map DD remove
map dd trash
map tt trash-list
map tr trash-restore
map te trash-empty

### PASTE (with undo support) ###
# lf's built-in `paste` doesn't log anything for `cmd undo` to act on, so the
# "paste" branch in `cmd undo` below was previously dead code - there was no
# way to trigger it. This wraps paste to actually record what it creates.
# Trade-off: this loses the built-in paste's live progress ruler for very
# large copies, in exchange for working undo. If you never use undo for
# paste, you can delete this block and `map p paste` will use lf's built-in
# implementation again (numbered-suffix conflict handling either way).
cmd paste %{{
    sep=$(printf '\037')
    sel_file="${XDG_DATA_HOME:-$HOME/.local/share}/lf/files"
    [ -f "$sel_file" ] || exit
    load=$(cat "$sel_file")
    mode=$(printf '%s\n' "$load" | sed -n '1p')
    list=$(printf '%s\n' "$load" | sed '1d')
    [ -z "$list" ] && exit

    printf '%s\n' "$list" | while IFS= read -r src; do
        [ -z "$src" ] && continue
        base=$(basename -- "$src")
        target="$PWD/$base"
        n=1
        while [ -e "$target" ]; do
            target="$PWD/${base}_$n"
            n=$((n + 1))
        done
        if [ "$mode" = 'copy' ]; then
            cp -r -- "$src" "$target"
        else
            mv -- "$src" "$target"
        fi
        printf 'paste%s%s\n' "$sep" "$target" >> /tmp/lf_undo_$USER
    done
    lf -remote 'send clear'
    lf -remote 'send reload'
}}
map p paste

### TOGGLE EXECUTABLE / PERMISSIONS ###
cmd chmod %{{
  sep=$(printf '\037')
  oldperms=$(stat -c "%a" "$f")
  printf "Chmod bits: "
  read -r bits
  [ -z "$bits" ] && exit
  chmod "$bits" "$f"
  printf 'chmod%s%s%s%s\n' "$sep" "$oldperms" "$sep" "$f" >> /tmp/lf_undo_$USER
  lf -remote 'send reload'
}}
map et chmod

