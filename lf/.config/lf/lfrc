# JUMP TO POPULAR AREAS #

# Pick a bookmarked directory with fzf and jump to it
cmd fzf_bookmark ${{
    sel=$(
        for d in \
            "$HOME" "$HOME/.config" "$HOME/Downloads" "$HOME/Documents" \
            "$HOME/Projects" "$HOME/Scripts" "$HOME/Pictures" "$HOME/Music" \
            "$HOME/Videos" "$HOME/Github" "$HOME/.local/scripts" \
            "$HOME/Applications" "$HOME/Archives" "$HOME/Code" "$HOME/Bin" \
            "$HOME/Diffs" "$HOME/Img" "$HOME/Macros" "$HOME/Virt" "$HOME/Other"
        do
            [ -d "$d" ] && printf '%s\n' "$d"
        done | fzf --reverse --prompt='Jump > ' \
            --preview 'eza -alF --group-directories-first --color=always --icons=always {}' \
            --preview-window 'right:50%:wrap'
    )
    [ -n "$sel" ] && lf -remote "send $id cd \"$sel\""
}}
map gb fzf_bookmark

# CUSTOM COMMANDS #
map ee $f

# Go to the removable media directory
cmd media %{{
    base="/run/media/$USER"
    set -- "$base"/*/
    if [ ! -d "$1" ]; then
        echo "No media mounted."
        exit 0
    fi
    # One device: go straight into it. Several: show the list.
    if [ $# -eq 1 ]; then
        target=${1%/}
    else
        target=$base
    fi
    esc=$(printf '%s' "$target" | sed 's/\\/\\\\/g; s/"/\\"/g')
    lf -remote "send $id cd \"$esc\""
}}
map gM media

# FILE CREATION #

# Create a directory, file, script or project by prompt
cmd mkdir %{{
    printf " Directory name: "
    read -r name
    [ -n "$name" ] || exit 0
    sep=$(printf '\037')
    [ -e "$name" ] && existed=true || existed=false
    mkdir -pv -- "$name"
    $existed || printf 'mkdir%s%s\n' "$sep" "$PWD/$name" >> /tmp/lf_undo_$USER
    lf -remote "send $id reload"
}}

cmd mkfile %{{
    printf " File name: "
    read -r name
    [ -n "$name" ] || exit 0
    sep=$(printf '\037')
    [ -e "$name" ] && existed=true || existed=false
    touch -- "$name"
    $existed || printf 'mkfile%s%s\n' "$sep" "$PWD/$name" >> /tmp/lf_undo_$USER
    lf -remote "send $id reload"
}}

# Prompts for name, language and template, then calls mkscript with flags
cmd mkscr %{{
    printf " Script name: "
    read -r name
    [ -n "$name" ] || exit 0
    printf " Language (bash/py) [bash]: "
    read -r lang
    printf " Template (basic/adv) [basic]: "
    read -r tmpl

    case "$lang" in
        py|python|python3) l=py ;;
        *)                 l=bash ;;
    esac
    case "$tmpl" in
        a|adv|advanced) t=-a ;;
        *)              t=-b ;;
    esac

    sep=$(printf '\037')
    [ -e "$HOME/Scripts/$name" ] && existed=true || existed=false
    if out=$(mkscript -n -l "$l" "$t" "$name" 2>&1); then
        $existed || printf 'mkscr%s%s\n' "$sep" "$HOME/Scripts/$name" >> /tmp/lf_undo_$USER
        lf -remote "send $id cd '~/Scripts/'"
    else
        printf '%s\n' "$out" | tail -n 1
        exit 1
    fi
}}

# Prompts for name, language and build system, then calls projtool with flags
cmd mkproj %{{
    printf " Project name: "
    read -r name
    [ -n "$name" ] || exit 0
    printf " Language (sh/py/lua/nvim/c/cpp/rs/go/zig/ino): "
    read -r lang
    [ -n "$lang" ] || exit 0
    printf " Build system (make/just/sh, blank = default): "
    read -r bs

    if out=$(projtool mkproj -n "$name" -l "$lang" -y ${bs:+-B "$bs"} 2>&1); then
        lf -remote "send $id cd \"$HOME/Projects/$name\""
    else
        printf '%s\n' "$out" | tail -n 1 | sed 's/\x1b\[[0-9;]*m//g'
        exit 1
    fi
}}
map md mkdir
map mf mkfile
map ms mkscr
map mp mkproj

# DELETE / TRASH #

# Move the selection to the trash and log it for undo
cmd trash %{{
    sep=$(printf '\037')
    for f in $fx; do
        printf 'trash%s%s\n' "$sep" "$f" >> /tmp/lf_undo_$USER
        trash-put -vr "$f"
    done
}}

# List trashed files in the pager
cmd trash-list ${{
    trash-list | ${PAGER:-less}
}}

# Restore files from the trash
cmd trash-restore ${{
    clear
    trash-restore
    lf -remote "send $id reload"
}}

# Empty the trash
cmd trash-empty %{{
    trash-empty
}}

# Permanently delete the selection
cmd remove %{{
    for f in $fx; do
        rm -rfv "$f"
    done
}}
map DD remove
map dd trash
map tt trash-list
map tr trash-restore
map te trash-empty

# PASTE (WITH UNDO SUPPORT) #

# Paste copied or cut files without overwriting and log for undo
cmd paste %{{
    sep=$(printf '\037')
    sel_file="${XDG_DATA_HOME:-$HOME/.local/share}/lf/files"
    [ -f "$sel_file" ] || exit
    load=$(cat "$sel_file")
    mode=$(printf '%s\n' "$load" | sed -n '1p')
    list=$(printf '%s\n' "$load" | sed '1d')
    [ -z "$list" ] && exit

    printf '%s\n' "$list" | while IFS= read -r src; do
        [ -z "$src" ] && continue
        base=$(basename -- "$src")
        target="$PWD/$base"
        n=1
        while [ -e "$target" ]; do
            target="$PWD/${base}_$n"
            n=$((n + 1))
        done
        if [ "$mode" = 'copy' ]; then
            cp -r -- "$src" "$target"
        else
            mv -- "$src" "$target"
        fi
        printf 'paste%s%s\n' "$sep" "$target" >> /tmp/lf_undo_$USER
    done
    lf -remote 'send clear'
    lf -remote 'send reload'
}}
map p paste

# TOGGLE EXECUTABLE / PERMISSIONS #

# Change file permissions by prompt and log for undo
cmd chmod %{{
  sep=$(printf '\037')
  oldperms=$(stat -c "%a" "$f")
  printf " Chmod bits: "
  read -r bits
  [ -z "$bits" ] && exit
  chmod "$bits" "$f"
  printf 'chmod%s%s%s%s\n' "$sep" "$oldperms" "$sep" "$f" >> /tmp/lf_undo_$USER
  lf -remote 'send reload'
}}
map et chmod

# ARCHIVE / EXTRACT #

# Extract the selected archives
cmd extract %{{
  sep=$(printf '\037')
  before=$(mktemp)
  ls -A > "$before"
  failed=
  for f in $fx; do
    if ! out=$(archives extract "$f" 2>&1); then
      failed=$(printf '%s\n' "$out" | grep '^Error' | tail -n 1 || true)
      [ -n "$failed" ] || failed="Extract failed: ${f##*/}"
    fi
  done
  new=$(ls -A | grep -vxFf "$before" || true)
  rm -f "$before"
  if [ -n "$new" ]; then
    line=$(printf '%s\n' "$new" | awk -v sep="$sep" -v pwd="$PWD" '{printf "%s%s/%s", sep, pwd, $0}')
    printf 'extract%s\n' "$line" >> /tmp/lf_undo_$USER
  fi
  lf -remote 'send reload'
  [ -z "$failed" ] || echo "$failed"
}}
map ex extract

# Archive the selection into a named archive
cmd archive %{{
  sep=$(printf '\037')
  printf " Archive name (.tar.gz/.zip/.rar): "
  read -r out
  [ -n "$out" ] || exit 0
  # Pass bare names (we are in the same directory) so the archive does not
  # store the full /home/... path of every member
  set -f
  names=$(printf '%s\n' "$fx" | sed 's|.*/||')
  if msg=$(archives archive "$out" $names 2>&1); then
    case "$out" in /*) path=$out ;; *) path="$PWD/$out" ;; esac
    printf 'archive%s%s\n' "$sep" "$path" >> /tmp/lf_undo_$USER
  else
    err=$(printf '%s\n' "$msg" | grep '^Error' | tail -n 1 || true)
    echo "${err:-Archive failed}"
    exit 1
  fi
  lf -remote 'send reload'
}}
map er archive

# VIDEO / AUDIO #

# These commands work on the selection, skip anything that isn't a video and run
# in the background (&): progress goes to the statusline, a desktop notification
# says when they are done, and lf stays usable during long batches.

# Extract the audio of the selected videos to ~/Music as mp3 (never overwrites).
# ":extract_audio delete" also trashes each original once its mp3 is written.
cmd extract_audio &{{
    set -f
    dest=${XDG_MUSIC_DIR:-$HOME/Music}
    sep=$(printf '\037')
    undo=/tmp/lf_undo_$USER
    okf=$(mktemp); skf=$(mktemp); erf=$(mktemp)
    trap 'rm -f "$okf" "$skf" "$erf"' EXIT

    is_video() {
        case "$(printf '%s' "$1" | tr 'A-Z' 'a-z')" in
            *.mp4|*.mkv|*.webm|*.mov|*.avi|*.m4v|*.flv|*.wmv) return 0 ;;
            *) return 1 ;;
        esac
    }
    report() {
        cnt=$(wc -l < "$2")
        [ "$cnt" -gt 0 ] || return 0
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$1 ($cnt)" "$(cat "$2")"
        fi
    }

    total=0
    for src in $fx; do
        is_video "$src" && total=$((total + 1))
    done
    [ "$total" -gt 0 ] || { lf -remote "send $id echo No video selected"; exit 0; }
    mkdir -p -- "$dest"

    i=0
    for src in $fx; do
        is_video "$src" || continue
        i=$((i + 1))
        name=${src##*/}
        lf -remote "send $id echo Extracting audio $i/$total"

        # ffmpeg would fail on a video without audio; check first
        if [ -z "$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_type -of csv=p=0 -i "$src" 2>/dev/null)" ]; then
            printf '%s\n' "$name" >> "$skf"
            continue
        fi

        stem=${name%.*}
        out="$dest/$stem.mp3"
        n=1
        while [ -e "$out" ]; do
            out="$dest/${stem}_$n.mp3"
            n=$((n + 1))
        done

        # Write to .part first so a failed run never leaves a broken mp3 behind
        if ffmpeg -nostdin -loglevel error -i "$src" -vn -map a:0 -c:a libmp3lame -q:a 2 -f mp3 "$out.part"; then
            mv -- "$out.part" "$out"
            printf 'convert%s%s\n' "$sep" "$out" >> "$undo"
            printf '%s\n' "$name" >> "$okf"
            if [ "${1:-}" = delete ] && trash-put -- "$src"; then
                printf 'trash%s%s\n' "$sep" "$src" >> "$undo"
            fi
        else
            rm -f -- "$out.part"
            printf '%s\n' "$name" >> "$erf"
        fi
    done

    report "Audio extracted" "$okf"
    report "No audio stream" "$skf"
    report "Extraction failed" "$erf"
    lf -remote "send $id reload"
    lf -remote "send $id echo Audio extraction finished"
}}

# Prompt for a quality, then hand the selection to compress_run in the background
cmd compress_video %{{
    printf " CRF 18-51, lower = better quality (default 28): "
    read -r crf
    case "$crf" in
        ''|*[!0-9]*) crf=28 ;;
    esac
    [ "$crf" -lt 18 ] && crf=18
    [ "$crf" -gt 51 ] && crf=51
    lf -remote "send $id compress_run $crf"
}}

# Re-encode the selected videos to x265 mp4 (":compress_run 30" skips the prompt).
# The original is only replaced when the result is actually smaller.
cmd compress_run &{{
    set -f
    crf=${1:-28}
    okf=$(mktemp); nsf=$(mktemp); erf=$(mktemp)
    trap 'rm -f "$okf" "$nsf" "$erf"' EXIT

    is_video() {
        case "$(printf '%s' "$1" | tr 'A-Z' 'a-z')" in
            *.mp4|*.mkv|*.webm|*.mov|*.avi|*.m4v|*.flv|*.wmv) return 0 ;;
            *) return 1 ;;
        esac
    }
    report() {
        cnt=$(wc -l < "$2")
        [ "$cnt" -gt 0 ] || return 0
        body=$(cat "$2")
        [ -z "${3:-}" ] || body=$(printf '%s\n%s' "$3" "$body")
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$1 ($cnt)" "$body"
        fi
    }

    total=0
    for src in $fx; do
        is_video "$src" && total=$((total + 1))
    done
    [ "$total" -gt 0 ] || { lf -remote "send $id echo No video selected"; exit 0; }

    i=0
    saved=0
    for src in $fx; do
        is_video "$src" || continue
        i=$((i + 1))
        lf -remote "send $id echo Compressing $i/$total (CRF $crf)"

        dir=${src%/*}
        base=${src##*/}
        stem=${base%.*}
        tmp="$dir/.$stem.compressing.mp4"
        final="$dir/$stem.mp4"
        # a.mkv -> a.mp4, but never clobber a different file that already has that name
        [ -e "$final" ] && [ "$final" != "$src" ] && final="$dir/${stem}_x265.mp4"

        # Keep audio the mp4 container accepts as-is, re-encode the rest (opus, vorbis, flac...)
        case "$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_name -of csv=p=0 -i "$src" 2>/dev/null | head -n 1)" in
            ''|aac|mp3|ac3|eac3) set -- -c:a copy ;;
            *)                   set -- -c:a aac -b:a 160k ;;
        esac

        if ffmpeg -nostdin -loglevel error -y -i "$src" \
            -map 0:v:0 -map '0:a:0?' -sn \
            -c:v libx265 -crf "$crf" -tag:v hvc1 "$@" \
            -movflags +faststart -f mp4 "$tmp"; then
            old=$(stat -c %s -- "$src")
            new=$(stat -c %s -- "$tmp")
            if [ "$new" -lt "$old" ]; then
                mv -f -- "$tmp" "$final"
                [ "$final" = "$src" ] || rm -f -- "$src"
                saved=$((saved + old - new))
                printf '%s\n' "$base" >> "$okf"
            else
                rm -f -- "$tmp"
                printf '%s\n' "$base" >> "$nsf"
            fi
        else
            rm -f -- "$tmp"
            printf '%s\n' "$base" >> "$erf"
        fi
    done

    report "Compressed videos" "$okf" "Saved $(numfmt --to=iec "$saved")"
    report "Not smaller, kept original" "$nsf"
    report "Compression failed" "$erf"
    lf -remote "send $id reload"
    lf -remote "send $id echo Compression finished"
}}
# Prompt for size, frame rate and length, then hand the selection to video_gif_run
cmd video_gif %{{
    printf " Width in px (default 480): "
    read -r w
    case "$w" in ''|*[!0-9]*) w=480 ;; esac
    [ "$w" -lt 16 ] && w=16
    printf " Frame rate 1-30 (default 12): "
    read -r fps
    case "$fps" in ''|*[!0-9]*) fps=12 ;; esac
    [ "$fps" -lt 1 ] && fps=1
    [ "$fps" -gt 30 ] && fps=30
    printf " Seconds to convert from the start (default 10): "
    read -r secs
    case "$secs" in ''|*[!0-9]*) secs=10 ;; esac
    [ "$secs" -lt 1 ] && secs=1
    lf -remote "send $id video_gif_run $w $fps $secs"
}}

# Turn the selected videos into gifs next to them (palette-optimised, never overwrites)
cmd video_gif_run &{{
    set -f
    w=${1:-480}
    fps=${2:-12}
    secs=${3:-10}
    sep=$(printf '\037')
    undo=/tmp/lf_undo_$USER
    okf=$(mktemp); erf=$(mktemp)
    trap 'rm -f "$okf" "$erf"' EXIT

    is_video() {
        case "$(printf '%s' "$1" | tr 'A-Z' 'a-z')" in
            *.mp4|*.mkv|*.webm|*.mov|*.avi|*.m4v|*.flv|*.wmv) return 0 ;;
            *) return 1 ;;
        esac
    }
    report() {
        cnt=$(wc -l < "$2")
        [ "$cnt" -gt 0 ] || return 0
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$1 ($cnt)" "$(cat "$2")"
        fi
    }

    total=0
    for src in $fx; do
        is_video "$src" && total=$((total + 1))
    done
    [ "$total" -gt 0 ] || { lf -remote "send $id echo No video selected"; exit 0; }

    i=0
    for src in $fx; do
        is_video "$src" || continue
        i=$((i + 1))
        lf -remote "send $id echo Making gif $i/$total"

        dir=${src%/*}
        name=${src##*/}
        stem=${name%.*}
        out="$dir/$stem.gif"
        n=1
        while [ -e "$out" ]; do
            out="$dir/${stem}_$n.gif"
            n=$((n + 1))
        done

        # Write to .part first so a failed run never leaves a broken gif behind
        if ffmpeg -nostdin -loglevel error -t "$secs" -i "$src" \
            -vf "fps=$fps,scale=min($w\,iw):-1:flags=lanczos,split[s0][s1];[s0]palettegen=stats_mode=diff[p];[s1][p]paletteuse=dither=bayer:bayer_scale=5" \
            -loop 0 -f gif "$out.part"; then
            mv -- "$out.part" "$out"
            printf 'convert%s%s\n' "$sep" "$out" >> "$undo"
            printf '%s\n' "${out##*/}" >> "$okf"
        else
            rm -f -- "$out.part"
            printf '%s\n' "$name" >> "$erf"
        fi
    done

    report "Gifs created" "$okf"
    report "Gif failed" "$erf"
    lf -remote "send $id reload"
    lf -remote "send $id echo Gif conversion finished"
}}

map ea extract_audio
map eA extract_audio delete
map ec compress_video
map eg video_gif

# IMAGES / PDF (IMAGEMAGICK) #

# Image commands work on the selection and skip anything that isn't an image.
# They never touch the originals: results are written next to them as new files
# (name_resized.png, name_rot90.jpg ...), never overwrite anything, and are
# logged so "u" removes them again. The work runs in the background (img_run);
# a desktop notification says when it is done.
# Needs ImageMagick 7 (the "magick" command).

# Convert to another format (png/jpg/webp/avif/gif/bmp/tiff/ico)
cmd img_convert %{{
    printf " Convert to (png/jpg/webp/avif/gif/bmp/tiff/ico) [png]: "
    read -r fmt
    fmt=$(printf '%s' "${fmt:-png}" | tr 'A-Z' 'a-z' | sed 's/^\.//')
    case "$fmt" in
        jpeg) fmt=jpg ;;
        tif)  fmt=tiff ;;
    esac
    case "$fmt" in
        png|jpg|webp|avif|gif|bmp|tiff|ico) ;;
        *) echo "Unsupported format: $fmt"; exit 1 ;;
    esac
    lf -remote "send $id img_run convert $fmt"
}}

# Resize: percentage (50%) or ImageMagick geometry (1280x, x720, 800x600, 800x600!)
cmd img_resize %{{
    printf " Size (50%%, 1280x, x720, 800x600, add ! to force) [50%%]: "
    read -r geo
    geo=${geo:-50%}
    case "$geo" in
        *[!0-9x%\!^\<\>]*) echo "Invalid size: $geo"; exit 1 ;;
    esac
    lf -remote "send $id img_run resize $geo"
}}

# Rotate, or just fix the orientation from the EXIF data
cmd img_rotate %{{
    printf " Rotate (r = 90 right, l = 90 left, f = 180, a = auto-orient) [r]: "
    read -r choice
    case "${choice:-r}" in
        r|R) arg=90 ;;
        l|L) arg=270 ;;
        f|F) arg=180 ;;
        a|A) arg=auto ;;
        *)   echo "Invalid choice: $choice"; exit 1 ;;
    esac
    lf -remote "send $id img_run rotate $arg"
}}

# Re-encode at a lower quality. A result that isn't smaller than the original is dropped.
cmd img_compress %{{
    printf " Quality 1-100, lower = smaller (default 80): "
    read -r q
    case "$q" in ''|*[!0-9]*) q=80 ;; esac
    [ "$q" -lt 1 ] && q=1
    [ "$q" -gt 100 ] && q=100
    lf -remote "send $id img_run compress $q"
}}

# Change the colour space (grey, srgb, cmyk, lab, hsl, hsb, hwb, xyz, ycbcr)
cmd img_colorspace %{{
    printf " Colour space (gray/srgb/cmyk/lab/hsl/hsb/hwb/xyz/ycbcr) [gray]: "
    read -r cs
    cs=$(printf '%s' "${cs:-gray}" | tr 'A-Z' 'a-z')
    case "$cs" in
        gray|grey|g) arg=Gray ;;
        srgb)        arg=sRGB ;;
        cmyk)        arg=CMYK ;;
        lab)         arg=Lab ;;
        hsl)         arg=HSL ;;
        hsb)         arg=HSB ;;
        hwb)         arg=HWB ;;
        xyz)         arg=XYZ ;;
        ycbcr)       arg=YCbCr ;;
        *) echo "Unsupported colour space: $cs"; exit 1 ;;
    esac
    lf -remote "send $id img_run colorspace $arg"
}}

# Shared worker: img_run convert|resize|rotate|strip|compress|colorspace|monochrome [argument]
# (":img_run strip" and ":img_run monochrome" need no argument, ":img_run colorspace Gray" is
# the one-key grey conversion)
cmd img_run &{{
    set -f
    op=${1:-}
    arg=${2:-}
    sep=$(printf '\037')
    undo=/tmp/lf_undo_$USER
    okf=$(mktemp); skf=$(mktemp); erf=$(mktemp)
    trap 'rm -f "$okf" "$skf" "$erf"' EXIT

    command -v magick >/dev/null 2>&1 || { lf -remote "send $id echo magick not found, install imagemagick"; exit 1; }
    case "$op" in
        convert|resize|rotate|strip|compress|colorspace|monochrome) ;;
        *) lf -remote "send $id echo Unknown image operation: $op"; exit 1 ;;
    esac
    case "$op" in
        resize)   suffix=_resized ;;
        rotate)   case "$arg" in auto) suffix=_oriented ;; *) suffix=_rot$arg ;; esac ;;
        strip)    suffix=_clean ;;
        compress) suffix=_small ;;
        colorspace) suffix=_$(printf '%s' "$arg" | tr 'A-Z' 'a-z') ;;
        monochrome) suffix=_mono ;;
        *)        suffix= ;;
    esac

    is_image() {
        case "$(printf '%s' "$1" | tr 'A-Z' 'a-z')" in
            *.jpg|*.jpeg|*.png|*.gif|*.webp|*.bmp|*.tif|*.tiff|*.avif|*.heic|*.heif|*.ico) return 0 ;;
            *) return 1 ;;
        esac
    }
    report() {
        cnt=$(wc -l < "$2")
        [ "$cnt" -gt 0 ] || return 0
        body=$(cat "$2")
        [ -z "${3:-}" ] || body=$(printf '%s\n%s' "$3" "$body")
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$1 ($cnt)" "$body"
        fi
    }

    total=0
    for src in $fx; do
        is_image "$src" && total=$((total + 1))
    done
    [ "$total" -gt 0 ] || { lf -remote "send $id echo No image selected"; exit 0; }

    i=0
    saved=0
    for src in $fx; do
        is_image "$src" || continue
        i=$((i + 1))
        lf -remote "send $id echo Image $op $i/$total"

        dir=${src%/*}
        name=${src##*/}
        stem=${name%.*}
        sext=$(printf '%s' "${name##*.}" | tr 'A-Z' 'a-z')
        case "$sext" in
            jpeg) norm=jpg ;;
            tif)  norm=tiff ;;
            heif) norm=heic ;;
            *)    norm=$sext ;;
        esac

        if [ "$op" = convert ]; then ext=$arg; else ext=$sext; fi
        if [ "$op" = convert ] && [ "$ext" = "$norm" ]; then
            printf '%s\n' "$name" >> "$skf"
            continue
        fi

        # First frame only, unless the result can be animated (gif/webp)
        frames='[0]'
        case "$ext" in gif|webp) frames= ;; esac
        set -- "$src$frames"
        if [ -z "$frames" ]; then
            set -- "$@" -coalesce
        fi
        set -- "$@" -auto-orient

        case "$op" in
            convert)
                case "$ext" in
                    jpg) set -- "$@" -background white -alpha remove -alpha off ;;
                    ico) set -- "$@" -resize '256x256>' -define icon:auto-resize=256,128,64,48,32,16 ;;
                esac
                ;;
            resize) set -- "$@" -resize "$arg" ;;
            rotate)
                case "$arg" in
                    auto) ;;
                    *)    set -- "$@" -rotate "$arg" ;;
                esac
                ;;
            strip) set -- "$@" -strip ;;
            colorspace) set -- "$@" -colorspace "$arg" ;;
            monochrome) set -- "$@" -monochrome ;;
            compress)
                # PNG is lossless, so quality does not apply: use maximum compression
                case "$ext" in
                    png) set -- "$@" -strip -define png:compression-level=9 ;;
                    *)   set -- "$@" -strip -quality "$arg" ;;
                esac
                ;;
        esac
        if [ "$ext" = gif ] && [ -z "$frames" ]; then
            set -- "$@" -layers Optimize
        fi

        # Write to a hidden temp file first so a failed run never leaves a broken image behind
        tmp="$dir/.$stem.lfimg.$ext"
        if magick "$@" "$tmp" 2>/dev/null; then
            if [ "$op" = compress ]; then
                old=$(stat -c %s -- "$src")
                new=$(stat -c %s -- "$tmp")
                if [ "$new" -ge "$old" ]; then
                    rm -f -- "$tmp"
                    printf '%s\n' "$name" >> "$skf"
                    continue
                fi
                saved=$((saved + old - new))
            fi
            out="$dir/$stem$suffix.$ext"
            n=1
            while [ -e "$out" ]; do
                out="$dir/$stem${suffix}_$n.$ext"
                n=$((n + 1))
            done
            mv -- "$tmp" "$out"
            printf 'convert%s%s\n' "$sep" "$out" >> "$undo"
            printf '%s\n' "${out##*/}" >> "$okf"
        else
            rm -f -- "$tmp"
            printf '%s\n' "$name" >> "$erf"
        fi
    done

    extra=
    [ "$op" != compress ] || extra="Saved $(numfmt --to=iec "$saved")"
    report "Images: $op" "$okf" "$extra"
    report "Skipped, nothing to do" "$skf"
    report "Image $op failed" "$erf"
    lf -remote "send $id reload"
    lf -remote "send $id echo Image $op finished"
}}

# Put the selected images into one PDF, one image per page (in the current directory)
# If this fails with "not authorized", the PDF rule in ImageMagick's policy.xml is blocking it.
cmd img_pdf %{{
    set -f
    sep=$(printf '\037')
    command -v magick >/dev/null 2>&1 || { echo "magick not found, install imagemagick"; exit 1; }
    printf " PDF name [images.pdf]: "
    read -r name
    name=${name:-images.pdf}
    case "$name" in
        */*) echo "Invalid name: $name"; exit 1 ;;
        *.pdf) ;;
        *) name=$name.pdf ;;
    esac
    if [ -e "$name" ]; then
        echo "Target exists: $name"
        exit 1
    fi

    set --
    for p in $fx; do
        case "$(printf '%s' "$p" | tr 'A-Z' 'a-z')" in
            *.jpg|*.jpeg|*.png|*.gif|*.webp|*.bmp|*.tif|*.tiff|*.avif|*.heic|*.heif)
                set -- "$@" "${p}[0]" ;;
        esac
    done
    [ $# -gt 0 ] || { echo "No image selected"; exit 0; }

    if err=$(magick "$@" -auto-orient "$name" 2>&1); then
        printf 'convert%s%s\n' "$sep" "$PWD/$name" >> "/tmp/lf_undo_$USER"
        lf -remote "send $id reload"
        lf -remote "send $id select \"$PWD/$name\""
    else
        rm -f -- "$name"
        printf '%s\n' "$err" | head -n 1
        exit 1
    fi
}}

# Merge the selected PDFs into one (in the current directory, in selection order)
cmd pdf_merge %{{
    set -f
    sep=$(printf '\037')
    command -v pdfunite >/dev/null 2>&1 || { echo "pdfunite not found, install poppler"; exit 1; }
    printf " Merged PDF name [merged.pdf]: "
    read -r name
    name=${name:-merged.pdf}
    case "$name" in
        */*) echo "Invalid name: $name"; exit 1 ;;
        *.pdf) ;;
        *) name=$name.pdf ;;
    esac
    if [ -e "$name" ]; then
        echo "Target exists: $name"
        exit 1
    fi

    set --
    for p in $fx; do
        case "$(printf '%s' "$p" | tr 'A-Z' 'a-z')" in
            *.pdf) set -- "$@" "$p" ;;
        esac
    done
    [ $# -ge 2 ] || { echo "Select at least two PDFs"; exit 1; }

    if err=$(pdfunite "$@" "$name" 2>&1); then
        printf 'convert%s%s\n' "$sep" "$PWD/$name" >> "/tmp/lf_undo_$USER"
        lf -remote "send $id reload"
        lf -remote "send $id select \"$PWD/$name\""
    else
        rm -f -- "$name"
        printf '%s\n' "$err" | head -n 1
        exit 1
    fi
}}

