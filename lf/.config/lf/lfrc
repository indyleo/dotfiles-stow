# GIT #

# Switch git branches with fzf
cmd git_branch ${{
    branch=$(
        {
            git for-each-ref --format='%(refname)' refs/heads | sed 's#^refs/heads/##'
            git for-each-ref --format='%(refname)' refs/remotes | sed 's#^refs/remotes/[^/]*/##'
        } | grep -vx 'HEAD' | awk '!seen[$0]++' |
            fzf --reverse --prompt='Branch > ' \
                --preview 'git log --oneline --color=always -n 15 {} -- 2>/dev/null'
    )
    [ -n "$branch" ] || exit 0
    if ! git switch "$branch"; then
        printf "Press Enter to continue..."
        read -r _
        exit 1
    fi
    pwd_shell="$(pwd | sed 's/\\/\\\\/g;s/"/\\"/g')"
    lf -remote "send $id updir; cd \"$pwd_shell\""
}}
