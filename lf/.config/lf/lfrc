# JUMP TO POPULAR AREAS #

# Pick a bookmarked directory with fzf and jump to it
cmd fzf_bookmark ${{
    sel=$(echo -e \
        "$HOME\n$HOME/.config\n$HOME/Downloads\n$HOME/Documents\n$HOME/Projects\n$HOME/Scripts\n$HOME/Pictures\n$HOME/Music\n$HOME/Videos\n$HOME/Github\n$HOME/.local/scripts\n$HOME/Applications\n$HOME/Archives\n$HOME/Code\n$HOME/Bin\n$HOME/Diffs\n$HOME/Img\n$HOME/Macros\n$HOME/Virt\n$HOME/Other" |
        while IFS= read -r d; do
            [ -d "$d" ] && echo "$d"
        done |
        fzf --reverse --prompt='Jump > ' \
            --preview 'eza -alF --group-directories-first --color=always --icons=always {}' \
            --preview-window 'right:50%:wrap' )
    [ -n "$sel" ] && lf -remote "send $id cd \"$sel\""
}}
map gb fzf_bookmark

