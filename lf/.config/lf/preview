#!/usr/bin/env bash
# lf preview script
# Preview files in lf with color, format awareness, and graceful fallbacks

preview="$1"
width="$2"
height="$3"
max_lines="${height:-80}"
max_cols="${width:-120}"

# Ensure target file exists
[[ -f "$preview" ]] || exit 1

# Cache directory for thumbnails
CACHE_DIR="$HOME/.cache/lf"
mkdir -p "$CACHE_DIR"

# NOTE: computing the cache key used to happen unconditionally at the top of
# the script (stat + sha256sum + awk = 3 extra subprocesses) on EVERY single
# preview call, even for plain text files that never touch $CACHE. Since lf
# re-invokes this script on every cursor move, that's real, constant
# per-keystroke overhead. Compute it lazily instead, only in the branches
# that actually cache a thumbnail.
CACHE=""
cache_key() {
    if [[ -z "$CACHE" ]]; then
        CACHE="$CACHE_DIR/thumbnail.$(stat --printf '%n\0%i\0%F\0%s\0%W\0%Y' -- "$(readlink -f "$preview")" | sha256sum | awk '{print $1}')"
    fi
    printf '%s' "$CACHE"
}

# Opportunistic cache pruning: thumbnails accumulate forever otherwise.
# Only pay the `find` cost once a day, tracked via a sentinel file, so this
# doesn't add overhead to every single preview call.
PRUNE_MARKER="$CACHE_DIR/.last_prune"
if [[ ! -f "$PRUNE_MARKER" ]] || [[ -n $(find "$PRUNE_MARKER" -mmin +1440 2>/dev/null) ]]; then
    ( find "$CACHE_DIR" -type f -name 'thumbnail.*' -mtime +30 -delete 2>/dev/null
    touch "$PRUNE_MARKER" ) &
    disown 2>/dev/null
fi

# Limit long output for performance
function headlimit() {
    awk -v max="$max_lines" 'NR<=max'
}

# Run a command and succeed ONLY if it exists, exits 0, and prints something.
# This is what makes `try a || try b || txtuse` chains actually fall through.
#
# Why not `a | headlimit || b`? In a pipeline the exit status is that of the
# LAST command (awk), which is always 0 -- so a missing/failing `a` produced
# empty output and the fallbacks never ran.
function try() {
    command -v "$1" >/dev/null 2>&1 || return 1
    local out
    out="$("$@" 2>/dev/null)" || return 1
    [[ -n "$out" ]] || return 1
    printf '%s\n' "$out" | headlimit
}

# Color-aware text display
function txtuse() {
    if command -v bat >/dev/null 2>&1; then
        bat --color=always --style=plain --pager=never "$preview" | headlimit && return
    elif command -v batcat >/dev/null 2>&1; then
        batcat --color=always --style=plain --pager=never "$preview" | headlimit && return
    elif command -v highlight >/dev/null 2>&1; then
        highlight --out-format=ansi "$preview" | headlimit && return
    else
        cat "$preview" | headlimit && return
    fi
}

# Show `git diff` for modified, tracked files (used for code/text fallback)
function git_diff_preview() {
    command -v git >/dev/null 2>&1 || return 1
    local dir
    dir="$(dirname -- "$preview")"
    git -C "$dir" rev-parse --verify -q HEAD >/dev/null 2>&1 || return 1
    git -C "$dir" ls-files --error-unmatch -- "$preview" >/dev/null 2>&1 || return 1
    git -C "$dir" diff --quiet HEAD -- "$preview" 2>/dev/null && return 1
    git -C "$dir" diff --color=always HEAD -- "$preview" 2>/dev/null | headlimit
}

# Image preview (fallback to metadata)
function imguse() {
    local img="${1:-$preview}"
    # NOTE: this used to be `if chafa; then ... elif viu; then ... fi`, which
    # meant viu was only ever tried when chafa was NOT installed. If chafa
    # *was* installed but failed at runtime (corrupt image, bad geometry,
    # unsupported format), the function fell straight to the mediainfo dump
    # instead of trying viu as a real second-line fallback. Splitting these
    # into separate `if` statements lets viu act as a genuine fallback.
    if command -v chafa >/dev/null 2>&1; then
        local w="${width:-80}"
        local geometry="$(( w > 2 ? w - 2 : w ))x${height:-40}"
        chafa "$img" -f sixel -s "$geometry" --animate false && return
    fi
    if command -v viu >/dev/null 2>&1; then
        viu -w "$max_cols" -h "$max_lines" "$img" && return
    fi
    command -v mediainfo >/dev/null 2>&1 && mediainfo "$img"
}

# Main type-based preview logic
case "${preview,,}" in
    *.bmp|*.jpg|*.jpeg|*.png|*.xpm|*.webp|*.tiff|*.gif|*.jfif|*.ico)
        imguse
        ;;

    *.svg)
        cache="$(cache_key)"
        if [ ! -f "${cache}.jpg" ]; then
            convert "$preview" "${cache}.jpg" 2>/dev/null
        fi
        if [ -f "${cache}.jpg" ]; then
            imguse "${cache}.jpg"
        else
            txtuse
        fi
        ;;

    *.avi|*.mp4|*.wmv|*.dat|*.3gp|*.ogv|*.mkv|*.mpg|*.mpeg|*.vob|*.flv|*.flic|*.m2v|*.mov|*.webm|*.ts|*.mts|*.m4v|*.ram|*.qt|*.divx)
        cache="$(cache_key)"
        if [ ! -f "${cache}.jpg" ]; then
            ffmpegthumbnailer -i "$preview" -o "${cache}.jpg" -s 0 -q 5 2>/dev/null
        fi
        if [ -f "${cache}.jpg" ]; then
            imguse "${cache}.jpg"
        else
            ffprobe -hide_banner -loglevel error \
                -show_entries format=duration,bit_rate:stream=codec_name,width,height \
                -of default=noprint_wrappers=1 "$preview" 2>/dev/null ||
            exiftool "$preview"
        fi
        ;;

    *.wav|*.mp3|*.flac|*.m4a|*.wma|*.ape|*.ac3|*.ogg|*.oga|*.ogx|*.spx|*.opus|*.asx|*.asf|*.mka|*.aac)
        exiftool "$preview" 2>/dev/null ||
        ffprobe -hide_banner -loglevel error \
            -show_entries format=duration,bit_rate:stream=codec_name \
            -of default=noprint_wrappers=1 "$preview" 2>/dev/null
        ;;

    *.pdf)
        cache="$(cache_key)"
        if [ ! -f "${cache}.jpg" ]; then
            pdftoppm -jpeg -f 1 -singlefile "$preview" "$cache" 2>/dev/null
        fi
        if [ -f "${cache}.jpg" ]; then
            imguse "${cache}.jpg"
        else
            try pdftotext "$preview" - ||
            try exiftool "$preview"
        fi
        ;;

    *.epub)
        cache="$(cache_key)"
        if [ ! -f "$cache" ]; then
            epub-thumbnailer "$preview" "$cache" 1024 2>/dev/null
        fi
        if [ -f "$cache" ]; then
            imguse "$cache"
        else
            epub-meta "$preview" 2>/dev/null || exiftool "$preview"
        fi
        ;;

    *.cbz|*.cbr|*.cbt)
        cache="$(cache_key)"
        if [ ! -f "$cache" ]; then
            comicthumb "$preview" "$cache" 1024 2>/dev/null
        fi
        if [ -f "$cache" ]; then
            imguse "$cache"
        else
            exiftool "$preview" 2>/dev/null
        fi
        ;;

    *.tgz|*.tar.gz) tar tzf "$preview" | headlimit ;;
    *.tar.bz2|*.tbz2) tar tjf "$preview" | headlimit ;;
    *.tar.xz|*.txz) xz --list "$preview" | headlimit ;;
    *.tar) tar tf "$preview" | headlimit ;;
    *.zip|*.jar|*.war|*.ear|*.oxt) unzip -l "$preview" | headlimit ;;
    *.rar) unrar l "$preview" | headlimit ;;
    *.7z) 7z l "$preview" | headlimit ;;

    *.md)
        if command -v glow >/dev/null 2>&1; then
            glow -s dark "$preview" | headlimit
        elif command -v mdcat >/dev/null 2>&1; then
            mdcat "$preview" | headlimit
        else
            txtuse
        fi
        ;;

    *.[1-8])
        man "$preview" | col -b | headlimit
        ;;

    *.torrent)
        try transmission-show "$preview" ||
        try exiftool "$preview"
        ;;

    *.iso)
        try iso-info --no-header -l "$preview" ||
        try isoinfo -d -i "$preview" ||
        try exiftool "$preview"
        ;;

    *.odt|*.ods|*.odp|*.sxw)
        try odt2txt "$preview" ||
        try exiftool "$preview"
        ;;

    *.doc)
        try catdoc "$preview" ||
        try exiftool "$preview"
        ;;

    *.docx)
        try docx2txt "$preview" - ||
        { unzip -p "$preview" | strings | headlimit; }
        ;;

    *.xls|*.xlsx)
        if command -v ssconvert >/dev/null 2>&1; then
            ssconvert --export-type=Gnumeric_stf:stf_csv "$preview" "fd://1" 2>/dev/null | headlimit
        else
            exiftool "$preview"
        fi
        ;;

    *.xml|*.html|*.htm)
        try w3m -dump "$preview" ||
        try lynx -dump "$preview" ||
        try elinks -dump "$preview" ||
        txtuse
        ;;

    *.json)
        try jq . "$preview" || txtuse
        ;;

    *.yaml|*.yml)
        try yq . "$preview" || txtuse
        ;;

    *.toml|*.ini|*.conf|*.cfg|*.config|*.lock)
        txtuse
        ;;

    *.o|*.obj)
        try nm "$preview" ||
        { xxd "$preview" | headlimit; }
        ;;

    *.bin)
        try xxd "$preview" ||
        try hexdump -C "$preview"
        ;;

    *.ino)
        if command -v bat >/dev/null 2>&1; then
            bat --color=always --style=plain --pager=never --language=cpp "$preview" | headlimit
        elif command -v batcat >/dev/null 2>&1; then
            batcat --color=always --style=plain --pager=never --language=cpp "$preview" | headlimit
        else
            txtuse
        fi
        ;;

        # Default fallback (also covers scripts/code: bash, git*, sh, zsh, py,
        # c, cpp, h, js, ts, go, rs, css, jsonnet, lua, etc. - txtuse is exactly
        # what the catch-all below already does, so a separate case for them
        # was redundant)
    *)
        git_diff_preview || txtuse
        ;;
esac

exit 0

